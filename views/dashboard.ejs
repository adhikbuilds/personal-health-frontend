<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal Health — Dashboard</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/dashboard.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/config.js"></script>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="logo">
      <span class="logo-mark">PH</span>
      <span class="logo-name">Personal Health</span>
    </div>
    <nav class="nav">
      <a class="nav-item <%= currentRoute === '/' ? 'active' : '' %>" href="/">Overview</a>
      <a class="nav-item <%= currentRoute === '/dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
      <a class="nav-item <%= currentRoute === '/wellness' ? 'active' : '' %>" href="/wellness">Wellness</a>
      <a class="nav-item <%= currentRoute === '/map' ? 'active' : '' %>" href="/map">Map</a>
    </nav>
    <div class="sidebar-status">
      <span class="dot <%= backendOnline ? 'green' : 'red' %>"></span>
      <span><%= backendOnline ? 'Backend online' : 'Backend offline' %></span>
    </div>
  </aside>

  <!-- Main -->
  <main class="main">

    <!-- Header -->
    <div class="page-header">
      <div>
        <h1>Dashboard</h1>
        <p class="sub">Live session monitoring &amp; athlete analytics</p>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Active Sessions</div>
        <div class="stat-value mono" id="stat-active">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Athletes</div>
        <div class="stat-value mono" id="stat-athletes">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Sessions Total</div>
        <div class="stat-value mono" id="stat-sessions">—</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Avg Form Score</div>
        <div class="stat-value mono" id="stat-avg-score">—</div>
      </div>
    </div>

    <!-- Content Grid -->
    <div class="grid">

      <!-- Left Column -->
      <div class="col-left">

        <!-- Active sessions from the app -->
        <div class="card" style="margin-bottom:16px">
          <div class="card-header">
            <span class="card-title">Live on App</span>
            <span class="muted small" id="active-refresh-ts"></span>
          </div>
          <div id="active-phone-list">
            <div class="empty-state">No active sessions</div>
          </div>
        </div>

        <!-- Live Session Panel — auto-connects when phone starts a session -->
        <div class="card" id="live-card" style="display:none">
          <div class="card-header">
            <span class="card-title">Live Metrics</span>
            <span class="badge badge-live">Live</span>
          </div>
          <div id="live-data">
            <div class="metric-grid">
              <div class="metric">
                <div class="metric-label">Form Score</div>
                <div class="metric-val mono" id="m-form">—</div>
                <div class="metric-unit">/ 100</div>
              </div>
              <div class="metric">
                <div class="metric-label">Left Knee</div>
                <div class="metric-val mono" id="m-knee-l">—</div>
                <div class="metric-unit">deg</div>
              </div>
              <div class="metric">
                <div class="metric-label">Right Knee</div>
                <div class="metric-val mono" id="m-knee-r">—</div>
                <div class="metric-unit">deg</div>
              </div>
              <div class="metric">
                <div class="metric-label">Hip Angle L</div>
                <div class="metric-val mono" id="m-hip-l">—</div>
                <div class="metric-unit">deg</div>
              </div>
              <div class="metric">
                <div class="metric-label">Hip Angle R</div>
                <div class="metric-val mono" id="m-hip-r">—</div>
                <div class="metric-unit">deg</div>
              </div>
              <div class="metric">
                <div class="metric-label">Spine Lean</div>
                <div class="metric-val mono" id="m-spine">—</div>
                <div class="metric-unit">deg</div>
              </div>
            </div>
            <canvas id="live-score-chart" height="60" style="width:100%;margin-top:12px;"></canvas>
            <div id="feedback-bar" class="feedback-bar" style="display:none"></div>
          </div>
        </div>

        <!-- Recent Sessions -->
        <div class="card" style="margin-top:16px">
          <div class="card-header">
            <span class="card-title">Recent Sessions</span>
          </div>
          <div id="sessions-list">
            <div class="empty-state">Loading...</div>
          </div>
        </div>

      </div>

      <!-- Right Column -->
      <div class="col-right">

        <!-- Leaderboard -->
        <div class="card">
          <div class="card-header">
            <span class="card-title">Leaderboard</span>
          </div>
          <div id="leaderboard-list">
            <div class="empty-state">Loading...</div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Progress slide panel -->
  <div id="progress-panel" style="position:fixed;top:0;right:-400px;width:380px;height:100vh;background:#111827;border-left:1px solid rgba(51,65,85,0.6);z-index:200;display:flex;flex-direction:column;transition:right 0.3s ease;overflow-y:auto;padding:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
      <span style="font-size:16px;font-weight:800;color:#f1f5f9;" id="panel-athlete-name">Athlete</span>
      <button onclick="closePanel()" style="background:none;border:none;color:#94a3b8;font-size:20px;cursor:pointer;">&#x2715;</button>
    </div>
    <div id="panel-content"><div class="empty-state">Loading...</div></div>
  </div>
  <div id="panel-overlay" onclick="closePanel()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:199;"></div>

  <script>
    const API_BASE = window.AB_CONFIG?.API_BASE || '/api';
    const WS_BASE  = `ws://${window.location.hostname}:${window.AB_CONFIG?.PROXY_PORT || 8083}/ws`;

    let liveChart = null;
    let activeWS = null;
    const liveScoreHistory = [];

    function initLiveChart() {
      const canvas = document.getElementById('live-score-chart');
      if (liveChart) liveChart.destroy();
      liveChart = new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: {
          labels: Array(20).fill(''),
          datasets: [{ data: Array(20).fill(null), borderColor: '#06b6d4', borderWidth: 2, pointRadius: 0, tension: 0.4, fill: false }]
        },
        options: {
          animation: false,
          plugins: { legend: { display: false } },
          scales: { x: { display: false }, y: { display: false, min: 0, max: 100 } },
          responsive: true, maintainAspectRatio: false,
        }
      });
    }

    function updateLiveChart(score) {
      if (!liveChart) return;
      liveScoreHistory.push(score);
      if (liveScoreHistory.length > 20) liveScoreHistory.shift();
      const padded = Array(20).fill(null);
      liveScoreHistory.forEach((v, i) => { padded[20 - liveScoreHistory.length + i] = v; });
      liveChart.data.datasets[0].data = padded;
      liveChart.update('none');
    }

    // ── Fetch helper ──────────────────────────────────────────────────────────
    async function get(path) {
      try {
        const r = await fetch(API_BASE + path);
        return r.ok ? r.json() : null;
      } catch { return null; }
    }

    function set(id, val) {
      const el = document.getElementById(id);
      if (el) el.textContent = val ?? '—';
    }

    // ── Stats Row ─────────────────────────────────────────────────────────────
    async function loadStats() {
      const [health, active] = await Promise.all([
        get('/health'),
        get('/sessions/active'),
      ]);
      set('stat-active', active?.count ?? '0');
      set('stat-athletes', health?.athletes_count ?? '0');
      set('stat-sessions', health?.sessions_count ?? '0');

      // Compute avg form score from recent sessions
      const recent = await get('/sessions?limit=20&status=completed');
      const sessions = recent?.sessions || [];
      const scores = sessions.map(s => s.summary?.avg_form_score).filter(s => s != null);
      if (scores.length > 0) {
        const avg = (scores.reduce((a, b) => a + b, 0) / scores.length).toFixed(1);
        set('stat-avg-score', avg);
      } else {
        set('stat-avg-score', '—');
      }
    }

    // ── Active Phone Sessions ─────────────────────────────────────────────────
    async function loadActiveSessions() {
      const data = await get('/sessions/active');
      const panel = document.getElementById('active-phone-list');
      const sessions = data?.active_sessions || [];
      if (!sessions.length) {
        panel.innerHTML = '<div class="empty-state">No active sessions — waiting for athletes on the app</div>';
        // Hide live card if no sessions
        document.getElementById('live-card').style.display = 'none';
        if (activeWS) { activeWS.close(); activeWS = null; }
        return;
      }
      panel.innerHTML = sessions.map(s => `
        <div class="lb-row" style="cursor:pointer;" onclick="connectToSession('${s.session_id}')">
          <span class="lb-avatar">${(s.athlete_id||'?')[0].toUpperCase()}</span>
          <div class="lb-info">
            <div class="lb-name">${s.athlete_id || 'Unknown'}</div>
            <div class="lb-meta">${s.sport || '—'} · ${s.frame_count ?? 0} frames</div>
          </div>
          <span class="lb-score">${s.latest_score != null ? s.latest_score.toFixed(1) : '—'}</span>
        </div>`).join('');

      // Auto-connect to first active session if not already connected
      if (!activeWS && sessions.length > 0) {
        connectToSession(sessions[0].session_id);
      }
    }

    // ── Live Session — auto-connects when phone session is detected ───────────
    function connectToSession(sessionId) {
      if (activeWS) activeWS.close();
      document.getElementById('live-card').style.display = 'block';
      liveScoreHistory.length = 0;
      initLiveChart();

      activeWS = new WebSocket(`${WS_BASE}/metrics/live/${sessionId}`);
      activeWS.onmessage = (e) => {
        const d = JSON.parse(e.data);
        if (d.type === 'ping') return;
        if (d.form_score != null) updateLiveChart(d.form_score);
        set('m-form',   d.form_score?.toFixed(1));
        set('m-knee-l', d.knee_angle_l?.toFixed(1));
        set('m-knee-r', d.knee_angle_r?.toFixed(1));
        set('m-hip-l',  d.hip_angle_l?.toFixed(1));
        set('m-hip-r',  d.hip_angle_r?.toFixed(1));
        set('m-spine',  d.trunk_lean?.toFixed(1));
        if (d.primary_feedback) {
          const fb = document.getElementById('feedback-bar');
          fb.textContent = d.primary_feedback;
          fb.style.display = 'block';
        }
      };
      activeWS.onclose = () => { activeWS = null; };
      activeWS.onerror = () => {};
    }

    // ── Leaderboard ───────────────────────────────────────────────────────────
    async function loadLeaderboard() {
      const data = await get('/leaderboard');
      const rows = data?.leaderboard || [];
      const list = document.getElementById('leaderboard-list');
      if (!rows.length) {
        list.innerHTML = '<div class="empty-state">No athletes registered yet</div>';
        return;
      }
      list.innerHTML = rows.slice(0, 10).map((a, i) => `
        <div class="lb-row" style="cursor:pointer;" onclick="openAthletePanel('${(a.id||'').replace(/'/g,"\\'")}','${(a.name||'').replace(/'/g,"\\'")}')">
          <span class="lb-rank ${i===0?'gold':i===1?'silver':i===2?'bronze':''}">${a.rank ?? i+1}</span>
          <span class="lb-avatar">${(a.avatar || a.name || '?')[0].toUpperCase()}</span>
          <div class="lb-info">
            <div class="lb-name">${a.name || a.id || 'Unknown'}</div>
            <div class="lb-meta">${a.sport || '—'} · ${a.tier || ''} · ${a.sessions ?? 0} sessions</div>
          </div>
          <span class="lb-score">${a.bpi != null ? a.bpi.toLocaleString() : '—'}</span>
        </div>`).join('');
    }

    // ── Sessions table ────────────────────────────────────────────────────────
    async function loadSessions() {
      const data = await get('/sessions?limit=8&status=completed');
      const list = document.getElementById('sessions-list');
      const sessions = data?.sessions || [];
      if (!sessions.length) {
        list.innerHTML = '<div class="empty-state">No completed sessions yet</div>';
        return;
      }
      list.innerHTML = `
        <table class="table">
          <thead><tr><th>Athlete</th><th>Sport</th><th>Frames</th><th>Avg Score</th></tr></thead>
          <tbody>${sessions.map(s => {
            const score = s.summary?.avg_form_score ?? null;
            const scoreColor = score >= 75 ? '#22c55e' : score >= 55 ? '#f59e0b' : score != null ? '#ef4444' : '#64748b';
            return `<tr style="cursor:pointer;" onclick="window.location='/session/${esc(s.session_id)}'">
              <td><a href="/athlete/${esc(s.athlete_id)}" style="color:#06b6d4;text-decoration:none;" onclick="event.stopPropagation()">${esc(s.athlete_id || '—')}</a></td>
              <td>${esc(s.sport || '—')}</td>
              <td class="mono">${s.frame_count ?? '—'}</td>
              <td class="mono" style="color:${scoreColor};font-weight:700;">${score != null ? score.toFixed(1) : '—'}</td>
            </tr>`;
          }).join('')}
          </tbody>
        </table>`;
    }

    // ── Athlete Progress Panel ─────────────────────────────────────────────────
    async function openAthletePanel(athleteId, name) {
      document.getElementById('panel-athlete-name').textContent = name || athleteId;
      document.getElementById('panel-content').innerHTML = '<div class="empty-state">Loading...</div>';
      document.getElementById('progress-panel').style.right = '0';
      document.getElementById('panel-overlay').style.display = 'block';
      const data = await get(`/athlete/${athleteId}/progress`);
      if (!data) {
        document.getElementById('panel-content').innerHTML = '<div class="empty-state">Could not load progress</div>';
        return;
      }
      const trend = data.form_trend || [];
      const imp = data.improvement_pct ?? 0;
      const impColor = imp >= 0 ? '#22c55e' : '#ef4444';
      const jointRows = Object.entries(data.joint_averages || {}).map(([k, v]) =>
        `<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.06);font-size:12px;">
          <span style="color:#94a3b8;">${k.replace(/_/g,' ')}</span>
          <span style="color:#f1f5f9;font-weight:700;">${v}&deg;</span>
        </div>`
      ).join('');
      document.getElementById('panel-content').innerHTML = `
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px;">
          <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:14px;">
            <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">Improvement</div>
            <div style="font-size:22px;font-weight:900;color:${impColor};">${imp > 0 ? '+' : ''}${imp}%</div>
          </div>
          <div style="background:rgba(255,255,255,0.04);border-radius:12px;padding:14px;">
            <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;">This Week</div>
            <div style="font-size:22px;font-weight:900;color:#06b6d4;">${data.sessions_this_week ?? 0}</div>
          </div>
        </div>
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;">Form Trend (${trend.length} sessions)</div>
        <div style="height:60px;margin-bottom:16px;">
          <canvas id="panel-trend-chart" height="60" style="width:100%;"></canvas>
        </div>
        <div style="font-size:10px;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:6px;">Joint Averages</div>
        ${jointRows || '<div style="color:#64748b;font-size:12px;">No joint data yet</div>'}
      `;
      if (trend.length > 1 && typeof Chart !== 'undefined') {
        new Chart(document.getElementById('panel-trend-chart').getContext('2d'), {
          type: 'line',
          data: { labels: trend.map(t => t.date), datasets: [{ data: trend.map(t => t.avg_form_score), borderColor: '#06b6d4', borderWidth: 2, pointRadius: 0, tension: 0.4, fill: false }] },
          options: { animation: false, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false, min: 0, max: 100 } }, responsive: true, maintainAspectRatio: false }
        });
      }
    }

    function closePanel() {
      document.getElementById('progress-panel').style.right = '-400px';
      document.getElementById('panel-overlay').style.display = 'none';
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    window.onload = () => {
      loadStats();
      loadActiveSessions();
      loadLeaderboard();
      loadSessions();
      // Refresh live data every 10s, leaderboard every 30s
      setInterval(() => {
        loadStats();
        loadActiveSessions();
        set('active-refresh-ts', 'updated ' + new Date().toLocaleTimeString());
      }, 10000);
      setInterval(loadLeaderboard, 30000);
    };
  </script>
</body>
</html>
