<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal Health — Coach Inbox</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/public/css/dashboard.css">
  <script src="/config.js"></script>
  <style>
    .wrap { max-width: 760px; margin: 0 auto; }

    .tabs { display: flex; gap: 4px; margin-bottom: 24px; }
    .tab {
      padding: 7px 16px; border-radius: 7px; font-size: 13px; font-weight: 600;
      cursor: pointer; border: 1px solid var(--border); background: none; color: var(--muted);
      transition: all 0.15s;
    }
    .tab.active { background: var(--accent); color: #000; border-color: var(--accent); }

    /* ── Broadcast list ── */
    .broadcast {
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      padding: 18px 20px; margin-bottom: 12px;
    }
    .broadcast-meta { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .broadcast-msg { font-size: 15px; color: var(--text); margin-bottom: 12px; }
    .broadcast-stats { display: flex; gap: 16px; font-size: 12px; color: var(--muted); }
    .bc-stat { display: flex; align-items: center; gap: 4px; }
    .bc-stat strong { color: var(--text); }

    .voice-player {
      display: flex; align-items: center; gap: 10px;
      background: rgba(6,182,212,0.07); border: 1px solid rgba(6,182,212,0.2);
      border-radius: 8px; padding: 10px 14px; margin-bottom: 12px;
    }
    .voice-player button {
      width: 32px; height: 32px; border-radius: 50%; border: none;
      background: var(--accent); color: #000; font-size: 14px; cursor: pointer;
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    }
    .voice-label { font-size: 13px; color: var(--muted); }

    .replies-toggle {
      font-size: 12px; color: var(--accent); cursor: pointer; border: none;
      background: none; padding: 0; font-weight: 600;
    }
    .replies-list { margin-top: 12px; border-top: 1px solid var(--border); padding-top: 12px; display: none; }
    .reply-row { display: flex; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.03); }
    .reply-row:last-child { border-bottom: none; }
    .reply-name { font-size: 13px; font-weight: 600; color: var(--text); min-width: 120px; }
    .reply-text { font-size: 13px; color: #d1d5db; flex: 1; }
    .reply-time { font-size: 11px; color: var(--muted); white-space: nowrap; }

    /* ── 1:1 Messages ── */
    .thread-list { display: flex; flex-direction: column; gap: 8px; }
    .thread-row {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 18px; display: flex; gap: 14px; align-items: center;
      cursor: pointer; text-decoration: none; color: inherit; transition: border-color 0.15s;
    }
    .thread-row:hover { border-color: var(--accent); }
    .thread-avatar {
      width: 38px; height: 38px; border-radius: 50%; background: rgba(6,182,212,0.15);
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; color: var(--accent); flex-shrink: 0;
    }
    .thread-name { font-size: 14px; font-weight: 600; color: var(--text); }
    .thread-preview { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .thread-time { font-size: 11px; color: var(--muted); margin-left: auto; white-space: nowrap; align-self: flex-start; }

    /* ── Message thread panel ── */
    #thread-panel {
      display: none; position: fixed; right: 0; top: 0; bottom: 0; width: 380px;
      background: var(--surface); border-left: 1px solid var(--border); z-index: 100;
      flex-direction: column;
    }
    #thread-panel.open { display: flex; }
    .thread-panel-head {
      padding: 18px 20px; border-bottom: 1px solid var(--border);
      display: flex; justify-content: space-between; align-items: center;
    }
    .thread-panel-head h3 { font-size: 15px; font-weight: 700; }
    .panel-close { background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; }
    .thread-msgs { flex: 1; overflow-y: auto; padding: 16px 20px; display: flex; flex-direction: column; gap: 10px; }
    .msg-bubble {
      max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.5;
    }
    .msg-bubble.coach { align-self: flex-end; background: var(--accent); color: #000; border-radius: 12px 12px 2px 12px; }
    .msg-bubble.athlete { align-self: flex-start; background: #1f2937; color: var(--text); border-radius: 12px 12px 12px 2px; }
    .msg-bubble .msg-time { font-size: 10px; opacity: 0.65; margin-top: 4px; }

    .thread-compose {
      padding: 14px 16px; border-top: 1px solid var(--border);
      display: flex; gap: 8px; align-items: flex-end;
    }
    .thread-compose textarea {
      flex: 1; background: #1a2235; border: 1px solid var(--border); color: var(--text);
      border-radius: 8px; padding: 9px 12px; font-size: 13px; font-family: 'Inter', sans-serif;
      resize: none; max-height: 120px; outline: none;
    }
    .btn-send { flex-shrink: 0; }

    .empty { text-align: center; padding: 48px 0; color: var(--muted); font-size: 14px; }

    .section-hidden { display: none; }
  </style>
</head>
<body>
  <aside class="sidebar">
    <div class="logo">
      <span class="logo-mark">PH</span>
      <span class="logo-name">Personal Health</span>
    </div>
    <nav class="nav">
      <a class="nav-item" href="/">Overview</a>
      <a class="nav-item" href="/dashboard">Dashboard</a>
      <a class="nav-item" href="/coach/<%= coachId %>/morning">Morning</a>
      <a class="nav-item active" href="/coach/<%= coachId %>/inbox">Inbox</a>
      <a class="nav-item" href="/coach/<%= coachId %>/billing">Billing</a>
      <a class="nav-item" href="/huddle">Huddle</a>
    </nav>
    <div class="sidebar-status">
      <span class="dot <%= backendOnline ? 'green' : 'red' %>"></span>
      <span><%= backendOnline ? 'Backend online' : 'Backend offline' %></span>
    </div>
  </aside>

  <main class="main">
    <div class="wrap">
      <div class="page-header">
        <div>
          <h1>Inbox</h1>
          <div class="sub">Broadcasts, replies, and 1:1 messages</div>
        </div>
      </div>

      <div class="tabs">
        <button class="tab active" id="tab-broadcasts" onclick="switchTab('broadcasts')">Broadcasts</button>
        <button class="tab" id="tab-messages" onclick="switchTab('messages')">1:1 Messages</button>
      </div>

      <div id="sec-broadcasts">
        <div id="broadcasts-list"><div class="empty">Loading...</div></div>
      </div>

      <div id="sec-messages" class="section-hidden">
        <div id="thread-list" class="thread-list"><div class="empty">Loading...</div></div>
      </div>
    </div>
  </main>

  <!-- 1:1 thread slide-in panel -->
  <div id="thread-panel">
    <div class="thread-panel-head">
      <h3 id="panel-title">Message</h3>
      <button class="panel-close" onclick="closePanel()">×</button>
    </div>
    <div class="thread-msgs" id="panel-msgs"></div>
    <div class="thread-compose">
      <textarea id="compose-text" rows="2" placeholder="Type a message..."></textarea>
      <button class="btn btn-send" onclick="sendMsg()">Send</button>
    </div>
  </div>

<script>
(function(){
  const API = (window.AB_CONFIG && window.AB_CONFIG.API_BASE) || '/api';
  const coachId = <%- JSON.stringify(coachId) %>;
  let _activeAthleteId = null;

  const _el = document.createElement('div');
  function esc(s){ _el.textContent = s==null?'':String(s); return _el.innerHTML; }
  function relTime(iso){
    if(!iso) return '';
    const d = new Date(iso), now = Date.now();
    const mins = Math.floor((now - d)/60000);
    if(mins < 1) return 'just now';
    if(mins < 60) return mins + 'm ago';
    if(mins < 1440) return Math.floor(mins/60) + 'h ago';
    return d.toLocaleDateString();
  }

  // ── Tab switch ──
  window.switchTab = function(tab){
    ['broadcasts','messages'].forEach(t => {
      document.getElementById('tab-'+t).classList.toggle('active', t===tab);
      document.getElementById('sec-'+t).classList.toggle('section-hidden', t!==tab);
    });
    if(tab==='messages') loadThreads();
  };

  // ── Broadcasts ──
  function loadBroadcasts(){
    fetch(API+'/coach/'+encodeURIComponent(coachId)+'/inbox')
      .then(r=>r.ok?r.json():Promise.reject())
      .then(renderBroadcasts)
      .catch(()=>{ document.getElementById('broadcasts-list').innerHTML = '<div class="empty">Could not load broadcasts.</div>'; });
  }

  function renderBroadcasts(data){
    const el = document.getElementById('broadcasts-list');
    const bcs = data.broadcasts || [];
    if(!bcs.length){ el.innerHTML='<div class="empty">No broadcasts yet.</div>'; return; }
    el.innerHTML = bcs.map((bc,i) => {
      const voiceHtml = bc.voice_note_url
        ? `<div class="voice-player">
            <button onclick="toggleAudio('audio-${i}',this)" aria-label="Play">&#9654;</button>
            <span class="voice-label">Voice note</span>
            <audio id="audio-${i}" src="${esc(API+bc.voice_note_url)}" preload="none"></audio>
           </div>` : '';
      const repliesHtml = bc.replies.map(r =>
        `<div class="reply-row">
          <div class="reply-name">${esc(r.athlete_name)}</div>
          <div class="reply-text">${esc(r.message||'[voice note]')}</div>
          <div class="reply-time">${relTime(r.replied_at)}</div>
         </div>`).join('');

      return `<div class="broadcast">
        <div class="broadcast-meta">
          <div class="broadcast-stats">
            <span class="bc-stat"><strong>${esc(bc.recipient_count)}</strong>&nbsp;athletes</span>
            <span class="bc-stat"><strong>${esc(bc.reply_count)}</strong>&nbsp;replies</span>
            <span class="bc-stat">${relTime(bc.sent_at)}</span>
          </div>
        </div>
        ${bc.message ? `<div class="broadcast-msg">${esc(bc.message)}</div>` : ''}
        ${voiceHtml}
        ${bc.replies.length ? `
          <button class="replies-toggle" onclick="toggleReplies(this)">Show ${bc.replies.length} ${bc.replies.length===1?'reply':'replies'}</button>
          <div class="replies-list">${repliesHtml}</div>` : ''}
      </div>`;
    }).join('');
  }

  window.toggleReplies = function(btn){
    const list = btn.nextElementSibling;
    const open = list.style.display === 'block';
    list.style.display = open ? 'none' : 'block';
    btn.textContent = open
      ? btn.textContent.replace('Hide','Show')
      : btn.textContent.replace('Show','Hide');
  };

  window.toggleAudio = function(id, btn){
    const audio = document.getElementById(id);
    if(audio.paused){ audio.play(); btn.innerHTML='&#9646;&#9646;'; }
    else { audio.pause(); btn.innerHTML='&#9654;'; }
    audio.onended = ()=>{ btn.innerHTML='&#9654;'; };
  };

  // ── 1:1 threads ──
  function loadThreads(){
    fetch(API+'/coach/'+encodeURIComponent(coachId)+'/messages')
      .then(r=>r.ok?r.json():Promise.reject())
      .then(renderThreads)
      .catch(()=>{ document.getElementById('thread-list').innerHTML='<div class="empty">Could not load messages.</div>'; });
  }

  function renderThreads(data){
    const el = document.getElementById('thread-list');
    const threads = data.threads||[];
    if(!threads.length){ el.innerHTML='<div class="empty">No 1:1 messages yet.</div>'; return; }
    el.innerHTML = threads.map(t =>
      `<div class="thread-row" onclick="openPanel('${esc(t.athlete_id)}','${esc(t.athlete_name)}')">
        <div class="thread-avatar">${esc((t.athlete_name||'?')[0].toUpperCase())}</div>
        <div class="thread-body">
          <div class="thread-name">${esc(t.athlete_name)}</div>
          <div class="thread-preview">${esc(t.last_msg_preview)}</div>
        </div>
        <div class="thread-time">${relTime(t.last_msg_at)}</div>
       </div>`).join('');
  }

  // ── Thread panel ──
  window.openPanel = function(athleteId, athleteName){
    _activeAthleteId = athleteId;
    document.getElementById('panel-title').textContent = athleteName;
    document.getElementById('thread-panel').classList.add('open');
    loadPanelMsgs();
  };

  window.closePanel = function(){
    document.getElementById('thread-panel').classList.remove('open');
    _activeAthleteId = null;
  };

  function loadPanelMsgs(){
    if(!_activeAthleteId) return;
    fetch(API+'/messages/'+encodeURIComponent(coachId)+'/'+encodeURIComponent(_activeAthleteId))
      .then(r=>r.ok?r.json():Promise.reject())
      .then(data=>{
        const el = document.getElementById('panel-msgs');
        const msgs = data.msgs||[];
        if(!msgs.length){ el.innerHTML='<div class="empty">No messages yet. Say hello.</div>'; return; }
        el.innerHTML = msgs.map(m => {
          const voiceHtml = m.voice_note_url
            ? `<div style="font-size:11px;opacity:0.7;margin-top:4px;">[voice note]</div>` : '';
          return `<div class="msg-bubble ${m.sender}">
            ${m.text ? esc(m.text) : ''}
            ${voiceHtml}
            <div class="msg-time">${relTime(m.sent_at)}</div>
          </div>`;
        }).join('');
        el.scrollTop = el.scrollHeight;
      })
      .catch(()=>{});
  }

  window.sendMsg = function(){
    const text = document.getElementById('compose-text').value.trim();
    if(!text || !_activeAthleteId) return;
    fetch(API+'/messages/'+encodeURIComponent(coachId)+'/'+encodeURIComponent(_activeAthleteId), {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({sender:'coach', text})
    })
    .then(r=>r.ok?r.json():Promise.reject())
    .then(()=>{
      document.getElementById('compose-text').value='';
      loadPanelMsgs();
    })
    .catch(()=>alert('Could not send message.'));
  };

  document.getElementById('compose-text').addEventListener('keydown', e=>{
    if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendMsg(); }
  });

  loadBroadcasts();
})();
</script>
</body>
</html>
