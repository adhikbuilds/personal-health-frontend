<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Personal Health</title>
  <link rel="stylesheet" href="/public/css/tokens.css">
  <link rel="stylesheet" href="/public/css/index.css">
  <script src="/config.js"></script>
</head>
<body>

  <% if (!backendOnline) { %>
  <div class="offline-bar">Backend offline — running in demo mode</div>
  <% } %>

  <nav class="navbar">
    <div class="nav-brand">
      <span class="logo-mark">PH</span>
      <span class="logo-name font-display">PERSONAL HEALTH</span>
    </div>
    <div class="nav-links">
      <a href="/dashboard" class="nav-link">Dashboard</a>
      <a href="/plan" class="nav-link">Training Plan</a>
      <a href="/huddle" class="nav-link">Huddle</a>
      <a href="/wellness" class="nav-link">Wellness</a>
      <a href="/map" class="nav-link">Map</a>
    </div>
    <div class="nav-right">
      <span class="status-dot <%= backendOnline ? 'online' : 'offline' %>"></span>
      <span class="status-text"><%= backendOnline ? 'Live' : 'Offline' %></span>
      <a href="/dashboard" class="btn-nav">Open Dashboard</a>
    </div>
  </nav>

  <main>
    <!-- HERO -->
    <section class="hero">
      <h1 class="font-display">SPORTS<br><span class="accent">BIOMECHANICS AI</span></h1>
      <p class="hero-sub">Real-time pose analysis, heart rate monitoring, and session tracking — built for the 99% of athletes who train without a personal coach.</p>
      <div class="hero-actions">
        <a href="/dashboard" class="btn-primary">Open Dashboard</a>
        <a href="/map" class="btn-secondary">View Map</a>
      </div>

      <!-- HERO STATS — 4 premium tiles -->
      <div class="hero-stats">
        <div class="ph-stat-card ph-stagger ph-stagger-1">
          <div class="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="label">Athletes</div>
          <div class="value"><%= athleteCount > 0 ? athleteCount : '0' %></div>
        </div>
        <div class="ph-stat-card ph-stagger ph-stagger-2">
          <div class="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="label">Sessions</div>
          <div class="value"><%= sessionsTotal || 0 %></div>
        </div>
        <div class="ph-stat-card warm ph-stagger ph-stagger-3">
          <div class="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 17 13.5 8.5 8.5 13.5 2 7"/><polyline points="16 17 22 17 22 11"/></svg>
          </div>
          <div class="label">Avg Form Score</div>
          <div class="value"><%= avgFormScore || '—' %></div>
        </div>
        <div class="ph-stat-card ph-stagger ph-stagger-4">
          <div class="icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div class="label">Active Now</div>
          <div class="value"><%= activeSessions > 0 ? activeSessions : '0' %></div>
        </div>
      </div>
    </section>

    <!-- INSIGHT CARDS — replace old feature cards with halo insight pattern -->
    <section class="insights">
      <div class="ph-insight-card success ph-stagger ph-stagger-1">
        <div class="halo"></div>
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <h3>Form Analysis</h3>
        <p>Real-time biomechanics from your phone camera. We grade joint angles, symmetry, and phase quality on every rep.</p>
      </div>
      <div class="ph-insight-card caution ph-stagger ph-stagger-2">
        <div class="halo"></div>
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h3>Injury Prevention</h3>
        <p>Asymmetry tracking flags risk before injury. We watch left-right imbalance across sessions and warn early.</p>
      </div>
      <div class="ph-insight-card info ph-stagger ph-stagger-3">
        <div class="halo"></div>
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h3>Heart Rate from Camera</h3>
        <p>rPPG via the front camera. Measures BPM and HRV from skin tone changes — no wearable needed.</p>
      </div>
    </section>

    <!-- LEADERBOARD -->
    <% if (topAthletes && topAthletes.length > 0) { %>
    <section class="leaderboard">
      <h2 class="font-display">TOP ATHLETES</h2>
      <div class="lb-table">
        <% topAthletes.forEach((a, i) => { %>
        <div class="lb-row">
          <span class="lb-rank <%= i===0?'gold':i===1?'silver':i===2?'bronze':'' %>"><%= i + 1 %></span>
          <span class="ph-avatar"><%= (a.avatar || a.name || '?')[0].toUpperCase() %></span>
          <div class="lb-info">
            <div class="lb-name"><%= a.name || a.id %></div>
            <div class="lb-meta"><%= a.sport || '—' %> · <span class="ph-tier <%= (a.tier || 'block').toLowerCase() %>"><%= a.tier || 'Athlete' %></span></div>
          </div>
          <span class="lb-bpi tabular"><%= (a.bpi || 0).toLocaleString() %> BPI</span>
        </div>
        <% }); %>
      </div>
      <a href="/dashboard" class="see-all">Full leaderboard in Dashboard →</a>
    </section>
    <% } %>
  </main>

</body>
</html>
